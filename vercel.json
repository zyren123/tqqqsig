
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "update_live.py",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/live",
      "destination": "/api"
    },
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
